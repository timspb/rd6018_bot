{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "poll_interval_s", "stale_after_s", "heartbeat_interval_s", "route", "source_snapshot", "outbox_path"],
  "properties": {
    "schema": {"const": 1},
    "poll_interval_s": {"type": "integer", "minimum": 5, "maximum": 3600, "default": 30, "description": "Seconds between read-only source snapshots."},
    "stale_after_s": {"type": "integer", "minimum": 30, "maximum": 3600, "default": 300, "description": "Telemetry freshness limit in seconds."},
    "heartbeat_interval_s": {"type": "integer", "minimum": 60, "maximum": 86400, "default": 300},
    "route": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{32}$"}], "description": "Externally supplied per-chat runtime configuration; never baked into source."},
    "source_snapshot": {"type": "string", "minLength": 1},
    "outbox_path": {"type": "string", "minLength": 1}
  }
}
